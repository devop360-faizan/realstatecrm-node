# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000

# ─── Database (MySQL) ─────────────────────────────────────────────────────────
DATABASE_URL="mysql://root:@localhost:3306/realstate_crm"

# ─── JWT Secrets ──────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_32_CHARS_ACCESS_SECRET_HERE
JWT_REFRESH_SECRET=CHANGE_ME_32_CHARS_REFRESH_SECRET_HERE
JWT_ACCESS_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug

# ─── File Upload ──────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=5